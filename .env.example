# 이 파일을 복사해서 .env.local 로 저장하고 실제 키를 채워 넣으세요.
# .env.local 은 .gitignore 에 의해 커밋되지 않습니다.

# Vite 앱(src/)에서 사용 — https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=여기에_TMDB_키
# Vite 앱(src/)에서 사용 — https://rapidapi.com/ (Streaming Availability)
VITE_RAPID_API_KEY=여기에_RapidAPI_키

# 로컬 Node 디버그 스크립트(test/, check/, verify/)용 — 필요할 때만
TMDB_API_KEY=여기에_TMDB_키
RAPID_API_KEY=여기에_RapidAPI_키
